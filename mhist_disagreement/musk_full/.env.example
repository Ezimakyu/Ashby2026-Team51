# Copy to .env in this folder (cp .env.example .env) and paste your token.
# A "read" token works, as long as your Hugging Face account has been approved
# for https://huggingface.co/xiangjx/musk. .env is gitignored; never commit it.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where the ~3.7 GB of MUSK weights are cached (default ~/.cache/huggingface).
# HF_HOME=/u/<username>/.cache/huggingface
